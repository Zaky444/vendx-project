{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "role": {
          ".write": false
        },
        "assigned_machine": {
          ".write": false
        },
        "is_active": {
          ".write": false
        }
      }
    },

    "machines": {
      ".read": false,
      ".write": false
    },

    "transactions": {
      ".read": false,
      ".write": false
    },

    "logs": {
      ".read": false,
      ".write": false
    }
  }
}